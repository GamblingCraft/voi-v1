{
  "name": "voi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "audit:project": "node scripts/audit-project.mjs",
    "format": "prettier --write src scripts tests docs *.json *.ts *.mjs",
    "format:check": "prettier --check src scripts tests docs *.json *.ts *.mjs",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@deemlol/next-icons": "^0.2.7",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
